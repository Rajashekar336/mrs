# Web port
PORT=4000
# Leave MONGODB_URI empty to use the built-in MongoDB (data saved in ./data/db).
# Or point to your own MongoDB, e.g. mongodb://127.0.0.1:27017 or a MongoDB Atlas URI.
MONGODB_URI=
# Port for the built-in MongoDB (connect with Compass/mongosh at mongodb://127.0.0.1:27018)
MONGO_PORT=27018
